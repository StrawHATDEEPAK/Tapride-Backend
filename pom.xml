<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tapride</groupId>
    <artifactId>tapride-parent</artifactId>
    <version>0.5.0</version>
    <packaging>pom</packaging>

    <name>tapride-parent</name>
    <description>
        Shared build configuration for all TapRide services. Deliberately NOT a
        multi-module reactor (no &lt;modules&gt; list) - each service is built and
        deployed independently (own CI pipeline, own Docker image, own release
        cadence). This POM only centralizes versions and plugin config so they
        don't drift or get duplicated across services; it does not couple their
        builds or deployability together.

        Each service inherits this via &lt;relativePath&gt;../pom.xml&lt;/relativePath&gt;,
        which Maven resolves locally without requiring `mvn install` first.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.4</spring-boot.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Listed BEFORE spring-boot-dependencies deliberately: Maven resolves
             conflicting versions in dependencyManagement by "first declared
             wins", and spring-boot-dependencies bundles its own (older) pinned
             Testcontainers version. Without this ordering, our explicit
             ${testcontainers.version} would silently lose to Spring Boot's. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM - gives every child service consistent, compatible
                versions of Spring/Jackson/etc without each having to declare them -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- Preserves parameter names in compiled bytecode (javac -parameters
                     flag). Without this, Spring MVC can't resolve @PathVariable/@RequestParam
                     by reflection unless every single one is explicitly named
                     (e.g. @PathVariable("id")) - easy to forget and fails at
                     REQUEST TIME, not compile time, which is exactly what happened
                     here. Setting this once in the parent POM fixes it project-wide
                     instead of hunting down every unnamed annotation individually. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
